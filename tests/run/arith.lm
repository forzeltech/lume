fn main() {
    let a i32 = 7;
    let b i32 = -3;
    print(a + b, a - b, a * b, a / b, a % b);
    let u u8 = 250;
    print(u + 5, u >> 1, u & 15, u | 1, u ^ 255, ~u);
    let big u64 = 18446744073709551615;
    print(big, i64(-9223372036854775807) - 1);
    let x = 1.5;
    let y f32 = 2.25;
    print(x * 2.0, y, f64(y) + x, 7.0 / 2.0, 10.0 % 4.0);
    print(i64(3.99), f64(7) / 2.0, i8(100), u16(65535));
    print(1 << 10, 0xff, 0b1010, 1_000_000);
    print('A', 'z' - 'a');
    print(true && !false, 3 < 4, 4 <= 4, 5 != 5);
}
// expect: 4 10 -21 -2 1
// expect: 255 125 10 251 5 5
// expect: 18446744073709551615 -9223372036854775808
// expect: 3.0 2.25 3.75 3.5 2.0
// expect: 3 3.5 100 65535
// expect: 1024 255 10 1000000
// expect: 65 25
// expect: true true true false
