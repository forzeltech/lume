fn mk() ([]str, error) { return nil, error("no"); }
fn main() (error) { var names []str = []; for (i in 0..3) { var x, err = mk(); if (err != nil) { x = names; }; x.push(i"t{i}"); } churn(); print(names); return nil; }
fn churn() { for (i in 0..3000) { let j = i"overwrite-{i}-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"; } }
// expect: ["t0", "t1", "t2"]
