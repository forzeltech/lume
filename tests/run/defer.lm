fn f(n i64) (i64, error) {
    defer print("f exit", n);
    if (n == 0) { return 0, error("zero"); }
    defer { print("second defer"); }
    return n * 2, nil;
}
fn g() (error) {
    defer print("g cleanup");
    let x, err = f(0);
    if (err != nil) { return err; }
    print("unreachable", x);
}
fn main() {
    let v, _ = f(3);
    print(v);
    let e = g();
    if (e != nil) { print("g failed:", e.msg); }
    for (i in 0..4) {
        defer print("iter end", i);
        if (i == 1) { continue; }
        if (i == 2) { break; }
        print("body", i);
    }
    {
        defer print("block end");
        print("in block");
    }
}
// expect: second defer
// expect: f exit 3
// expect: 6
// expect: f exit 0
// expect: g cleanup
// expect: g failed: zero
// expect: body 0
// expect: iter end 0
// expect: iter end 1
// expect: iter end 2
// expect: in block
// expect: block end
